<section class="vitruvium-sheet character-sheet">
  <header class="character-header">
    <div class="character-name">
      <header class="character-name-header">
        <h1>{{actor.name}}</h1>
        <button type="button" class="panel-action" data-vitruvium-action="edit-name" aria-label="Изменить имя персонажа">⋯</button>
      </header>
      {{#if editingName}}
        <div class="character-name-editor">
          <input class="inline-edit character-name-input" type="text" value="{{actor.name}}" aria-label="Имя персонажа" required>
          <div class="form-actions"><button type="button" data-vitruvium-action="save-name">Сохранить</button><button type="button" data-vitruvium-action="cancel-name">Отмена</button></div>
        </div>
      {{/if}}
      <section class="inspiration-panel header-inspiration">
        <header><h2>Вдохновение</h2></header>
        <div class="inspiration-counter">
          <button type="button" data-vitruvium-action="adjust-inspiration" data-delta="-1" aria-label="Уменьшить вдохновение">−</button>
          <b>{{system.inspiration}}</b><span>/ {{maxInspiration}}</span>
          <button type="button" data-vitruvium-action="adjust-inspiration" data-delta="1" aria-label="Увеличить вдохновение">+</button>
        </div>
      </section>
    </div>
    <section class="stat-panel">
      <header><h2>Характеристики</h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="characteristics" aria-label="Редактировать характеристики">⋯</button></header>
      <div class="stat-strip">
        {{#each characteristics as |characteristic key|}}
          <div class="characteristic-card" title="{{characteristic.label}}">
            <span>{{characteristic.label}}</span>
            {{#if ../editing.characteristics}}
              <div class="stepper">
                <button type="button" data-vitruvium-action="adjust-characteristic" data-characteristic="{{key}}" data-delta="-1" aria-label="Снизить {{characteristic.label}}">−</button>
                <b>{{lookup (lookup ../system.characteristics key) "value"}}</b>
                <button type="button" data-vitruvium-action="adjust-characteristic" data-characteristic="{{key}}" data-delta="1" aria-label="Увеличить {{characteristic.label}}">+</button>
              </div>
            {{else}}
              <button type="button" class="characteristic-roll" data-vitruvium-action="roll-characteristic" data-characteristic="{{key}}" aria-label="Бросить {{characteristic.label}}: {{characteristic.total}} куб.">
                <b>{{lookup (lookup ../system.characteristics key) "value"}}</b>
              </button>
            {{/if}}
            <small class="characteristic-total">{{#if characteristic.modifier}}({{characteristic.modifierText}} от статусов) · {{/if}}Итого: {{characteristic.total}} куб.</small>
            {{#if characteristic.advantage}}<small class="characteristic-total">Преимущество +{{characteristic.advantage}}</small>{{/if}}
            {{#if characteristic.hindrance}}<small class="characteristic-total">Помеха +{{characteristic.hindrance}}</small>{{/if}}
          </div>
        {{/each}}
      </div>
    </section>
  </header>
  <div class="character-layout">
    <aside class="left-column">
      <section class="panel profile-panel">
        <div class="profile-frame">
          {{#if actorHasImage}}<img class="profile" src="{{actor.img}}" alt="Портрет персонажа">{{/if}}
          <div class="profile-actions">
            <label class="image-button">{{#if actorHasImage}}Изменить фото{{else}}Добавить фото{{/if}}<input type="file" data-actor-image accept="image/*"></label>
            {{#if tokenizerAvailable}}<button type="button" data-vitruvium-action="tokenize-actor-image">Создать портрет в Tokenizer</button>{{/if}}
            {{#if actorHasImage}}<button type="button" data-vitruvium-action="remove-actor-image">Удалить фото</button>{{/if}}
          </div>
        </div>
      </section>
      <section class="panel status-panel">
        <header><h2>Статусы</h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="statuses" aria-label="Редактировать статусы">⋯</button></header>
        <div class="scroll-list">
          {{#each statuses}}
            <article class="entity-card compact status-card {{#if hasImage}}has-image{{/if}}">
              {{#if (lookup ../editingItems id)}}
                <div class="entity-edit">
                  <input class="inline-edit" data-item-id="{{id}}" data-item-field="name" value="{{name}}" aria-label="Название статуса">
                  <textarea class="inline-edit" data-item-id="{{id}}" data-item-field="system.description" aria-label="Описание статуса">{{system.description}}</textarea>
                  <label class="status-active-toggle"><input type="checkbox" data-status-active {{#if system.active}}checked{{/if}}>Активен — эффекты учитываются при бросках</label>
                  <div class="status-effects">
                    <b>Эффекты характеристик</b>
                    {{#each system.effects}}
                      <div class="status-effect" data-status-effect-id="{{id}}">
                        <label>Характеристика
                          <select data-status-effect-field="characteristic">
                            {{#each characteristicOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                          </select>
                        </label>
                        <label>Тип эффекта
                          <select data-status-effect-field="type">
                            {{#each typeOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                          </select>
                        </label>
                        <label>Значение<input type="number" step="1" value="{{value}}" data-status-effect-field="value"></label>
                        <button type="button" data-vitruvium-action="remove-status-effect">Удалить эффект</button>
                      </div>
                    {{/each}}
                    <button type="button" data-vitruvium-action="add-status-effect">Добавить эффект</button>
                  </div>
                  <div class="image-actions"><label class="image-button">Изменить фото<input type="file" data-item-image="{{id}}" accept="image/*"></label><button type="button" data-vitruvium-action="remove-item-image" data-item-id="{{id}}">Удалить фото</button></div>
                  <div class="form-actions"><button type="button" data-vitruvium-action="save-item" data-item-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="cancel-item" data-item-id="{{id}}">Отмена</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>
                </div>
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
              {{else}}
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
                <div class="status-content"><b>{{name}}</b>
                  <small class="status-state">{{#if system.active}}Активен{{else}}Неактивен{{/if}}</small>
                </div>
                {{#if ../editing.statuses}}<div class="status-actions"><button type="button" data-vitruvium-action="edit-item" data-item-id="{{id}}">Изменить</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>{{/if}}
                {{#if system.description}}<details class="description-details"><summary>Описание</summary><p>{{system.description}}</p></details>{{/if}}
                {{#if hasEffects}}
                  <details class="status-effect-details">
                    <summary>Эффекты ({{system.effects.length}})</summary>
                    <ul>{{#each system.effects}}<li><span>{{label}}:</span> <b>{{displayValue}}</b> <span>— {{characteristicLabel}}</span></li>{{/each}}</ul>
                  </details>
                {{/if}}
              {{/if}}
            </article>
          {{else}}<p class="empty">Статусы не добавлены.</p>{{/each}}
        </div>
        {{#if editing.statuses}}<button type="button" class="add-card" data-vitruvium-action="create-item" data-type="status">Добавить статус</button>{{/if}}
      </section>
    </aside>
    <main class="main-column">
      <section class="panel attributes-panel">
        <header><h2>Атрибуты <span>{{attributes.length}} / 12</span></h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="attributes" aria-label="Редактировать атрибуты">⋯</button></header>
        <div class="card-grid scroll-list">
          {{#each attributes}}
            <article class="entity-card {{#if hasImage}}has-image{{/if}}">
              {{#if (lookup ../editingItems id)}}
                <div class="entity-edit">
                  <input class="inline-edit" data-item-id="{{id}}" data-item-field="name" value="{{name}}" aria-label="Название атрибута">
                  <textarea class="inline-edit" data-item-id="{{id}}" data-item-field="system.description" aria-label="Описание атрибута">{{system.description}}</textarea>
                  <div class="image-actions"><label class="image-button">Изменить фото<input type="file" data-item-image="{{id}}" accept="image/*"></label><button type="button" data-vitruvium-action="remove-item-image" data-item-id="{{id}}">Удалить фото</button></div>
                  <div class="form-actions"><button type="button" data-vitruvium-action="save-item" data-item-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="cancel-item" data-item-id="{{id}}">Отмена</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>
                </div>
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
              {{else}}
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
                <div class="entity-content"><b>{{name}}</b>
                  {{#if ../editing.attributes}}<div class="form-actions"><button type="button" data-vitruvium-action="edit-item" data-item-id="{{id}}">Изменить</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>{{/if}}
                </div>
                {{#if system.description}}<details class="description-details"><summary>Описание</summary><p>{{system.description}}</p></details>{{/if}}
              {{/if}}
            </article>
          {{else}}<p class="empty">Атрибуты не добавлены.</p>{{/each}}
          {{#if editing.attributes}}<button type="button" class="add-card" data-vitruvium-action="create-item" data-type="attribute">Добавить атрибут</button>{{/if}}
        </div>
      </section>
      <section class="panel domains-panel">
        <header><h2>Домены <span>{{domains.length}} / 6</span></h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="domains" aria-label="Редактировать домены">⋯</button></header>
        <div class="domain-list scroll-list">
          {{#each domains}}
            <article class="domain-card {{#if hasImage}}has-image{{/if}}">
              {{#if (lookup ../editingItems id)}}
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
                <div class="domain-edit entity-edit">
                  <input class="inline-edit" data-item-id="{{id}}" data-item-field="name" value="{{name}}" aria-label="Название домена">
                  <label class="level-field">Уровень<input class="inline-edit" data-item-id="{{id}}" data-item-field="system.value" type="number" min="1" max="3" value="{{system.value}}" aria-label="Уровень домена"></label>
                  <textarea class="inline-edit" data-item-id="{{id}}" data-item-field="system.description" aria-label="Описание домена">{{system.description}}</textarea>
                  <div class="image-actions"><label class="image-button">Изменить фото<input type="file" data-item-image="{{id}}" accept="image/*"></label><button type="button" data-vitruvium-action="remove-item-image" data-item-id="{{id}}">Удалить фото</button></div>
                </div>
              {{else}}
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
                <div class="domain-content">
                  <div class="domain-title"><b>{{name}}</b><span>Уровень {{system.value}}</span></div>
                </div>
              {{/if}}
              {{#unless (lookup ../editingItems id)}}{{#if system.description}}<details class="description-details"><summary>Описание</summary><p>{{system.description}}</p></details>{{/if}}{{/unless}}
              {{#if (lookup ../editingItems id)}}
                <div class="form-actions"><button type="button" data-vitruvium-action="save-item" data-item-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="cancel-item" data-item-id="{{id}}">Отмена</button><button type="button" class="delete-card" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить домен</button></div>
              {{else}}
                {{#if ../editing.domains}}<div class="form-actions"><button type="button" data-vitruvium-action="edit-item" data-item-id="{{id}}">Изменить</button><button type="button" class="delete-card" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить домен</button></div>{{/if}}
              {{/if}}
              <div class="ability-list">
                {{#each abilities}}
                  <div class="ability-item {{#if hasImage}}has-image{{/if}}">
                    {{#if (lookup ../../editingItems id)}}
                      {{#if hasImage}}<img class="ability-image" src="{{img}}" alt="">{{/if}}
                      <div class="ability-edit entity-edit">
                        <input class="inline-edit" data-item-id="{{id}}" data-item-field="name" value="{{name}}" aria-label="Название способности">
                        <textarea class="inline-edit" data-item-id="{{id}}" data-item-field="system.description" aria-label="Описание способности">{{system.description}}</textarea>
                        <div class="image-actions"><label class="image-button">Изменить фото<input type="file" data-item-image="{{id}}" accept="image/*"></label><button type="button" data-vitruvium-action="remove-item-image" data-item-id="{{id}}">Удалить фото</button></div>
                        <div class="form-actions"><button type="button" data-vitruvium-action="save-item" data-item-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="cancel-item" data-item-id="{{id}}">Отмена</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>
                      </div>
                    {{else}}
                      {{#if hasImage}}<img class="ability-image" src="{{img}}" alt="">{{/if}}
                      <div class="ability-content"><span>{{name}}</span>
                        {{#if ../../editing.domains}}<div class="form-actions"><button type="button" data-vitruvium-action="edit-item" data-item-id="{{id}}">Изменить</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>{{/if}}
                      </div>
                      {{#if system.description}}<details class="description-details"><summary>Описание</summary><p>{{system.description}}</p></details>{{/if}}
                    {{/if}}
                  </div>
                {{else}}<p class="empty">Способностей нет.</p>{{/each}}
              </div>
              {{#if ../editing.domains}}<button type="button" class="add-card small" data-vitruvium-action="create-ability" data-domain-id="{{id}}">Добавить способность</button>{{/if}}
            </article>
          {{else}}<p class="empty">Домены не добавлены.</p>{{/each}}
          {{#if editing.domains}}<button type="button" class="add-card" data-vitruvium-action="create-item" data-type="domain">Добавить домен</button>{{/if}}
        </div>
      </section>
      <section class="panel possessions-panel">
        <header><h2>Имущество</h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="possessions" aria-label="Редактировать имущество">⋯</button></header>
        <div class="horizontal-list scroll-list">
          {{#each possessions}}
            <article class="possession-card {{#if hasImage}}has-image{{/if}} {{#if (lookup ../editingItems id)}}is-editing{{/if}}">
              {{#if (lookup ../editingItems id)}}
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
                <div class="entity-edit">
                  <input class="inline-edit" data-item-id="{{id}}" data-item-field="name" value="{{name}}" aria-label="Название предмета">
                  <textarea class="inline-edit" data-item-id="{{id}}" data-item-field="system.description" aria-label="Описание предмета">{{system.description}}</textarea>
                  <div class="image-actions"><label class="image-button">Изменить фото<input type="file" data-item-image="{{id}}" accept="image/*"></label><button type="button" data-vitruvium-action="remove-item-image" data-item-id="{{id}}">Удалить фото</button></div>
                  <div class="form-actions"><button type="button" data-vitruvium-action="save-item" data-item-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="cancel-item" data-item-id="{{id}}">Отмена</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>
                </div>
              {{else}}
                {{#if hasImage}}<img class="entity-image" src="{{img}}" alt="">{{/if}}
                <div class="entity-content"><span>{{name}}</span>
                  {{#if ../editing.possessions}}<div class="form-actions"><button type="button" data-vitruvium-action="edit-item" data-item-id="{{id}}">Изменить</button><button type="button" data-vitruvium-action="delete-item" data-item-id="{{id}}">Удалить</button></div>{{/if}}
                </div>
                {{#if system.description}}<details class="description-details"><summary>Описание</summary><p>{{system.description}}</p></details>{{/if}}
              {{/if}}
            </article>
          {{else}}<p class="empty">Имущество не добавлено.</p>{{/each}}
          {{#if editing.possessions}}<button type="button" class="add-card" data-vitruvium-action="create-item" data-type="possession">Добавить имущество</button>{{/if}}
        </div>
      </section>
      <section class="panel relationships-panel">
        <header><h2>Отношения</h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="relationships" aria-label="Редактировать отношения">⋯</button></header>
        <div class="scroll-list">
          {{#each relationships}}
            <article class="relationship {{#if hasImage}}has-image{{/if}}">
              {{#if ../editing.relationships}}
                {{#if hasImage}}<img class="relationship-portrait" src="{{portrait}}" alt="">{{/if}}
                <div class="relationship-edit">
                  <input class="inline-edit" data-relationship-id="{{id}}" data-relationship-field="name" value="{{name}}" aria-label="Название отношения">
                  <textarea class="inline-edit" data-relationship-id="{{id}}" data-relationship-field="description" aria-label="Описание отношения">{{description}}</textarea>
                  <div class="relationship-status-editor">
                    <b>Статусы</b>
                    <div class="relationship-status-list">
                      {{#each statuses}}<div class="relationship-status-row"><input type="text" data-relationship-status value="{{this}}" aria-label="Статус отношения"><button type="button" data-vitruvium-action="remove-relationship-status">Удалить</button></div>{{/each}}
                    </div>
                    <button type="button" data-vitruvium-action="add-relationship-status">Добавить статус</button>
                  </div>
                </div>
                <label class="relationship-edit-value">Уровень<input class="inline-edit" data-relationship-id="{{id}}" data-relationship-field="value" type="number" min="{{relationshipMin}}" max="{{relationshipMax}}" value="{{value}}" aria-label="Уровень отношения"></label>
                <div class="relationship-edit-actions form-actions">
                  <label class="image-button">Изменить фото<input type="file" data-relationship-image="{{id}}" accept="image/*"></label>
                  {{#if portrait}}<button type="button" data-vitruvium-action="remove-relationship-image" data-id="{{id}}">Удалить фото</button>{{/if}}
                  <button type="button" data-vitruvium-action="save-relationship" data-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="toggle-edit" data-section="relationships">Отмена</button><button type="button" data-vitruvium-action="remove-relationship" data-id="{{id}}">Удалить</button>
                </div>
              {{else}}
                {{#if hasImage}}<img class="relationship-portrait" src="{{portrait}}" alt="">{{/if}}
                <div class="relationship-content"><b>{{name}}</b>
                  {{#if statuses.length}}<ul class="relationship-statuses">{{#each statuses}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
                </div>
                <div class="relationship-level"><button type="button" data-vitruvium-action="adjust-relationship" data-id="{{id}}" data-delta="-1" aria-label="Уменьшить уровень отношения">−</button><strong>{{value}}</strong><button type="button" data-vitruvium-action="adjust-relationship" data-id="{{id}}" data-delta="1" aria-label="Увеличить уровень отношения">+</button></div>
                {{#if ../editing.relationships}}<div class="form-actions"><button type="button" data-vitruvium-action="toggle-edit" data-section="relationships">Изменить</button><button type="button" data-vitruvium-action="remove-relationship" data-id="{{id}}">Удалить</button></div>{{/if}}
                {{#if description}}<details class="description-details"><summary>Описание</summary><p>{{description}}</p></details>{{/if}}
              {{/if}}
            </article>
          {{else}}<p class="empty">Отношения не добавлены.</p>{{/each}}
          {{#if editing.relationships}}<button type="button" class="add-card" data-vitruvium-action="add-relationship">Добавить отношение</button>{{/if}}
        </div>
      </section>
      <section class="panel resources-panel">
        <header><h2>Ресурсы</h2><button type="button" class="panel-action" data-vitruvium-action="toggle-edit" data-section="resources" aria-label="Редактировать ресурсы">⋯</button></header>
        <div class="resource-list">
          {{#each resources}}
            <article class="resource-card {{#if hasImage}}has-image{{/if}}">
              {{#if (lookup ../editingItems id)}}
                {{#if hasImage}}<img class="resource-image" src="{{img}}" alt="">{{/if}}
                <div class="resource-edit entity-edit">
                  <input class="inline-edit" data-resource-id="{{id}}" data-resource-field="name" value="{{name}}" aria-label="Название ресурса">
                  <textarea class="inline-edit" data-resource-id="{{id}}" data-resource-field="description" aria-label="Описание ресурса">{{description}}</textarea>
                  <label>Текущее <input class="inline-edit resource-number" data-resource-id="{{id}}" data-resource-field="value" type="number" min="0" max="{{max}}" value="{{value}}"></label>
                  <label>Максимум <input class="inline-edit resource-number" data-resource-id="{{id}}" data-resource-field="max" type="number" min="0" value="{{max}}"></label>
                  <label class="image-button">Изменить фото<input type="file" data-resource-image="{{id}}" accept="image/*"></label>
                  {{#if img}}<button type="button" data-vitruvium-action="remove-resource-image" data-resource-id="{{id}}">Удалить фото</button>{{/if}}
                  <div class="form-actions"><button type="button" data-vitruvium-action="save-resource" data-resource-id="{{id}}">Сохранить</button><button type="button" data-vitruvium-action="cancel-resource" data-resource-id="{{id}}">Отмена</button><button type="button" data-vitruvium-action="delete-resource" data-resource-id="{{id}}">Удалить</button></div>
                </div>
              {{else}}
                {{#if hasImage}}<img class="resource-image" src="{{img}}" alt="">{{/if}}
                <div class="resource-content"><b>{{name}}</b>
                  {{#if ../editing.resources}}<div class="form-actions"><button type="button" data-vitruvium-action="edit-resource" data-resource-id="{{id}}">Изменить</button><button type="button" data-vitruvium-action="delete-resource" data-resource-id="{{id}}">Удалить</button></div>{{/if}}
                </div>
                <div class="resource-value"><button type="button" data-vitruvium-action="adjust-resource" data-resource-id="{{id}}" data-delta="-1" aria-label="Уменьшить {{name}}">−</button><strong>{{value}}</strong><button type="button" data-vitruvium-action="adjust-resource" data-resource-id="{{id}}" data-delta="1" aria-label="Увеличить {{name}}">+</button><span>/ {{max}}</span></div>
                {{#if description}}<details class="description-details"><summary>Описание</summary><p>{{description}}</p></details>{{/if}}
              {{/if}}
            </article>
          {{else}}<p class="empty">Ресурсы не добавлены.</p>{{/each}}
          {{#if editing.resources}}<button type="button" class="add-card small" data-vitruvium-action="add-resource">Добавить ресурс</button>{{/if}}
        </div>
      </section>
    </main>
  </div>
</section>
