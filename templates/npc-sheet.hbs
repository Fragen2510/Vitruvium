<section class="vitruvium-sheet npc-sheet">
  <header class="npc-header">
    <h1>{{actor.name}}</h1>
  </header>
  <section class="npc-stats">
    <label class="npc-stat">
      <span>Атака</span>
      <input type="number" min="0" max="99" data-npc-stat="attackDice" value="{{npc.attackDice}}" aria-label="Базовые кубики атаки">
      <small>dV</small>
      <button type="button" data-npc-action="roll" data-target="attack">Бросить атаку</button>
    </label>
    <label class="npc-stat">
      <span>Защита</span>
      <input type="number" min="0" max="99" data-npc-stat="defenseDice" value="{{npc.defenseDice}}" aria-label="Базовые кубики защиты">
      <small>dV</small>
      <button type="button" data-npc-action="roll" data-target="defense">Бросить защиту</button>
    </label>
  </section>
  <section class="npc-abilities">
    <header><h2>Способности</h2><button type="button" data-npc-action="add-ability">Добавить способность</button></header>
    <div class="npc-ability-list">
      {{#each npc.abilities}}
        <article class="npc-ability">
          <label class="npc-ability-name"><span>Способность</span><input type="text" data-npc-ability-field="name" data-ability-id="{{id}}" value="{{name}}"></label>
          <label class="npc-ability-bonus"><span>Прибавка кубов</span><input type="number" min="0" max="99" data-npc-ability-field="bonusDice" data-ability-id="{{id}}" value="{{bonusDice}}"><small>dV</small></label>
          <div class="npc-ability-actions">
            <button type="button" data-npc-action="roll" data-target="attack" data-ability-id="{{id}}">Атака</button>
            <button type="button" data-npc-action="roll" data-target="defense" data-ability-id="{{id}}">Защита</button>
            <button type="button" class="npc-delete-ability" data-npc-action="delete-ability" data-ability-id="{{id}}" aria-label="Удалить способность">Удалить</button>
          </div>
        </article>
      {{else}}
        <p class="empty">Способностей пока нет.</p>
      {{/each}}
    </div>
  </section>
  <section class="npc-statuses">
    <header><h2>Статусы</h2><button type="button" data-npc-action="add-status">Добавить статус</button></header>
    <div class="npc-status-list">
      {{#each npc.statuses}}
        <article class="npc-status" data-npc-status-id="{{id}}">
          <div class="npc-status-heading">
            <input type="text" data-npc-status-field="name" value="{{name}}" aria-label="Название статуса">
            <label class="npc-status-active"><input type="checkbox" data-npc-status-field="active" {{#if active}}checked{{/if}}>Активен</label>
            <button type="button" data-npc-action="delete-status" data-status-id="{{id}}">Удалить статус</button>
          </div>
          <textarea data-npc-status-field="description" aria-label="Описание статуса" placeholder="Описание">{{description}}</textarea>
          <div class="npc-status-effects">
            <b>Эффекты атаки и защиты</b>
            {{#each effects}}
              <div class="npc-status-effect" data-npc-status-effect-id="{{id}}">
                <label>Цель
                  <select data-npc-status-effect-field="target">
                    <option value="attack" {{#if isAttack}}selected{{/if}}>Атака</option>
                    <option value="defense" {{#if isDefense}}selected{{/if}}>Защита</option>
                  </select>
                </label>
                <label>Тип эффекта
                  <select data-npc-status-effect-field="type">
                    <option value="dice" {{#if isDice}}selected{{/if}}>Изменение кубов</option>
                    <option value="advantage" {{#if isAdvantage}}selected{{/if}}>Преимущество</option>
                    <option value="hindrance" {{#if isHindrance}}selected{{/if}}>Помеха</option>
                  </select>
                </label>
                <label>Значение<input type="number" min="{{minModifier}}" max="{{maxModifier}}" step="1" data-npc-status-effect-field="modifier" value="{{modifier}}"></label>
                <button type="button" data-npc-action="delete-status-effect" data-status-id="{{../id}}" data-effect-id="{{id}}">Удалить эффект</button>
              </div>
            {{/each}}
            <button type="button" data-npc-action="add-status-effect" data-status-id="{{id}}">Добавить эффект</button>
          </div>
        </article>
      {{else}}
        <p class="empty">Статусы не добавлены.</p>
      {{/each}}
    </div>
  </section>
</section>
